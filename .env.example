# Sao chép file này thành .env. Không commit .env.
APP_NAME="Financial Data Platform API"
ENVIRONMENT="local"

# Vnstock Free Unified API. Điền key lấy từ tài khoản Vnstock vào file .env local.
# Không commit key và không đặt key ở frontend.
DATA_PROVIDER="VNSTOCK_FREE"
VNSTOCK_API_KEY=""
VNSTOCK_REQUESTS_PER_MINUTE="60"

# Credential dự phòng cho provider khác; adapter Vnstock không sử dụng biến này.
DATA_PROVIDER_API_KEY=""

# Các đường dẫn tương đối tính từ project root.
RAW_DATA_DIR="data/raw/ohlcv"
CURATED_DATA_DIR="data/curated/ohlcv"
SEED_RAW_DATA_DIR="reports/raw/ohlcv"
UNIVERSE_PATH="universe/ticker_universe_v1.csv"

# Frontend gọi backend. Docker Compose sẽ override thành http://backend:8000.
API_BASE_URL="http://localhost:8000"

# Danh sách origin phân cách bằng dấu phẩy.
CORS_ORIGINS="http://localhost:8501"

